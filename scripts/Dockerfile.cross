# syntax=docker/dockerfile:1
# Unified gaz-cart DEB: headless radapter, all three plugins and Lua runtime.
#
# Requires QEMU binfmt for the arm64 sysroot stage (same as radapter's):
#   docker run --privileged --rm tonistiigi/binfmt --install arm64
#
# Extract the .deb:
#   docker buildx build -f scripts/Dockerfile.cross --target pkg --output=out .
#   ls out/gaz-cart_*.deb

ARG TARGET_PLATFORM=arm64

# ═══════════════════════════════════════════════════════════════════════
# Stage: sysroot — target-arch Qt6 dev stack (what radapter-sdk's public
# interface + gaz_nav need: Core/Network/WebSockets/SerialPort/SerialBus/Sql
# come from radapter-qt, Gui from gaz_nav itself)
# ═══════════════════════════════════════════════════════════════════════
FROM --platform=${TARGET_PLATFORM} debian:bookworm-slim AS sysroot
ENV DEBIAN_FRONTEND=noninteractive
RUN apt update && apt install -y \
        qt6-base-dev \
        qt6-websockets-dev qt6-serialbus-dev qt6-serialport-dev \
        libgl1-mesa-dev libxkbcommon-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN apt update
RUN apt install -y libboost-container-dev libboost-serialization-dev
RUN apt install -y libtbb-dev libceres-dev libeigen3-dev
RUN apt install -y libblas-dev libsuitesparse-dev liblapack-dev
# Debian's Ceres was built against ATLAS; its CeresTargets.cmake hard-codes
# libatlas/libf77blas paths, so the dev symlinks must exist.
RUN apt install -y libatlas-base-dev

# ═══════════════════════════════════════════════════════════════════════
# Stage: builder — host cross-toolchain + host Qt6 codegen tools + sysroot
# ═══════════════════════════════════════════════════════════════════════
FROM debian:bookworm-slim AS builder
ARG TARGET_PLATFORM
ENV DEBIAN_FRONTEND=noninteractive
RUN apt update && apt install -y \
        git cmake ninja-build build-essential file \
        gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
        qt6-base-dev qt6-base-dev-tools \
    && rm -rf /var/lib/apt/lists/*
RUN apt update && apt install -y libboost-all-dev
COPY --from=sysroot /lib /sysroot/lib
COPY --from=sysroot /usr/lib /sysroot/usr/lib
COPY --from=sysroot /usr/bin /sysroot/usr/bin
COPY --from=sysroot /usr/include /sysroot/usr/include
# Eigen3 ships its CMake config under /usr/share — needed by find_package in
# the sysroot-restricted cross build.
COPY --from=sysroot /usr/share /sysroot/usr/share

# Debian Ceres records /usr/lib/aarch64-linux-gnu/lib{lapack,blas,f77blas,atlas}.so
# in its link interface. CMake uses those absolute paths verbatim (no sysroot
# re-rooting for imported-target paths), and the host has no such directory —
# so create it and point the names at the real libs in the sysroot (lapack/blas
# are ATLAS alternatives symlinks into /etc, which isn't copied).
RUN mkdir -p /usr/lib/aarch64-linux-gnu && \
    ln -sf /sysroot/usr/lib/aarch64-linux-gnu/atlas/liblapack.so  /usr/lib/aarch64-linux-gnu/liblapack.so && \
    ln -sf /sysroot/usr/lib/aarch64-linux-gnu/atlas/libblas.so    /usr/lib/aarch64-linux-gnu/libblas.so && \
    ln -sf /sysroot/usr/lib/aarch64-linux-gnu/libf77blas.so       /usr/lib/aarch64-linux-gnu/libf77blas.so && \
    ln -sf /sysroot/usr/lib/aarch64-linux-gnu/libatlas.so         /usr/lib/aarch64-linux-gnu/libatlas.so

# Qt6 tool fixup: copy host codegen tools (moc/rcc/...) into the sysroot
RUN case "${TARGET_PLATFORM}" in \
    'arm64') \
        mkdir -p /sysroot/usr/lib/qt6/libexec; \
        cp -RLf /usr/lib/qt6/libexec/* /sysroot/usr/lib/qt6/libexec/; \
        mkdir -p /sysroot/usr/lib/qt6/bin; \
        cp -RLf /usr/lib/qt6/bin/* /sysroot/usr/lib/qt6/bin/ 2>/dev/null || true; \
        ;; \
    *) ;; \
    esac

# Reuse the submodule's toolchain file — same sysroot layout as radapter's
COPY radapter/scripts/cmake/toolchain_arm64.cmake /opt/radapter/cmake/
COPY . /src
WORKDIR /src
ENV CPM_SOURCE_CACHE=/cpm

# ═══════════════════════════════════════════════════════════════════════
# Stage: cart-builder — headless radapter + all plugins, then cpack
# ═══════════════════════════════════════════════════════════════════════
FROM builder AS cart-builder
# Cross-compiling: FindBLAS/FindLAPACK's check_function_exists probes fail under
# QEMU/cross, so point Ceres' SuiteSparse check at the sysroot libs directly.
RUN --mount=type=cache,target=/cpm \
    cmake \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_TOOLCHAIN_FILE=/opt/radapter/cmake/toolchain_arm64.cmake \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D GAZ_PACKAGE_RUNTIME=ON \
        -D GAZ_BUILD_FRAMES=ON \
        -D GAZ_BUILD_NAV=ON \
        -D GAZ_BUILD_SLAM=ON \
        -D GAZ_DEB_CROSS_DISTRIBUTION=bookworm \
        -D RADAPTER_SDK_ONLY=OFF \
        -D RADAPTER_GUI=OFF \
        -D RADAPTER_STATIC=OFF \
        -D RADAPTER_JIT=OFF \
        -D RADAPTER_JIT_STATIC=OFF \
        -D RADAPTER_ROS2=OFF \
        -D BLAS_LIBRARIES=/sysroot/usr/lib/aarch64-linux-gnu/atlas/libblas.so \
        -D LAPACK_LIBRARIES=/sysroot/usr/lib/aarch64-linux-gnu/atlas/liblapack.so \
        -G Ninja -B /build \
    && cmake --build /build -j$(nproc)
WORKDIR /build
RUN cpack -G DEB

# ═══════════════════════════════════════════════════════════════════════
# Stage: pkg
# ═══════════════════════════════════════════════════════════════════════
FROM scratch AS pkg
COPY --from=cart-builder /build/gaz-cart_*.deb /
